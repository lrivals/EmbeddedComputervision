{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yolo-embarque:manifest:1",
  "title": "manifest.json — format d'échange du modèle entier (format_version 1)",
  "description": "Produit par l'export Python (T4.7), lu par le golden C++ (T5.1), le testbench HLS et le driver ARM. Sémantique : docs/conventions.md, section « Format d'échange ».",
  "type": "object",
  "required": ["format_version", "network", "classes", "input", "anchors", "blobs", "buffers", "layers"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": 1},
    "network": {"type": "string", "minLength": 1},
    "classes": {"type": "integer", "minimum": 1},
    "input": {
      "type": "object",
      "required": ["shape", "scale", "buf"],
      "additionalProperties": false,
      "properties": {
        "shape": {
          "type": "array",
          "prefixItems": [{"const": 1}, {"enum": [1, 3]}, {"$ref": "#/$defs/dim"}, {"$ref": "#/$defs/dim"}],
          "items": false,
          "minItems": 4
        },
        "scale": {"$ref": "#/$defs/scale"},
        "buf": {"$ref": "#/$defs/bufref"}
      }
    },
    "anchors": {
      "description": "Ancres en pixels pour une entrée de 416, triées par aire croissante ; non entières pour YOLOv2 (1,08 cellule × 32 = 34,56 px).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}],
        "items": false,
        "minItems": 2
      }
    },
    "blobs": {
      "description": "Taille en octets de chaque fichier binaire ; luts.bin (tables du décodage, §9.4) est écrit par l'export réel ; checksum.bin (ABFT, T25.2: int32 checksum filter Σ_f qW_f of each conv, C × k × k) as well.",
      "type": "object",
      "required": ["weights.bin", "bias.bin", "requant.bin"],
      "additionalProperties": false,
      "properties": {
        "weights.bin": {"$ref": "#/$defs/size"},
        "bias.bin": {"$ref": "#/$defs/size"},
        "requant.bin": {"$ref": "#/$defs/size"},
        "luts.bin": {"$ref": "#/$defs/size"},
        "checksum.bin": {"$ref": "#/$defs/size"}
      }
    },
    "buffers": {
      "description": "Tampons d'activations en DDR : nom → taille en octets.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/bufname"},
      "additionalProperties": {"$ref": "#/$defs/size"}
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/conv"},
          {"$ref": "#/$defs/maxpool"},
          {"$ref": "#/$defs/upsample"},
          {"$ref": "#/$defs/route"},
          {"$ref": "#/$defs/yolo"},
          {"$ref": "#/$defs/region"}
        ]
      }
    }
  },
  "$defs": {
    "dim": {"type": "integer", "minimum": 1},
    "exp_frac": {
      "description": "Bits fractionnaires de la table exponentielle (les deux autres sont en Q16).",
      "type": "integer", "minimum": 0, "maximum": 16
    },
    "lut_offset": {
      "description": "Offset (octets) dans luts.bin des 3 tables uint32 de 256 entrées de la tête : sigmoïde, exponentielle, exponentielle du softmax (§9.4).",
      "$ref": "#/$defs/offset64"
    },
    "size": {"type": "integer", "minimum": 0},
    "id": {"type": "integer", "minimum": 0},
    "scale": {"type": "number", "exclusiveMinimum": 0},
    "offset64": {"type": "integer", "minimum": 0, "multipleOf": 64},
    "bufname": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
    "bufref": {
      "description": "Position d'un tenseur (C, H, W) int8 contigu dans un tampon ; offset en octets.",
      "type": "object",
      "required": ["buf", "offset"],
      "additionalProperties": false,
      "properties": {
        "buf": {"$ref": "#/$defs/bufname"},
        "offset": {"type": "integer", "minimum": 0}
      }
    },
    "shape": {
      "description": "Forme de sortie (C, H, W).",
      "type": "array",
      "prefixItems": [{"$ref": "#/$defs/dim"}, {"$ref": "#/$defs/dim"}, {"$ref": "#/$defs/dim"}],
      "items": false,
      "minItems": 3
    },
    "pool": {
      "description": "Maxpool 2×2 exécuté dans l'étage de sortie de la conv (§10.3). s = 1 : complétion par réplication, ⌊(k − 1)/2⌋ en haut et à gauche, le reste en bas et à droite (§4.4) ; k = 5, s = 1 : SPP de YOLOv7-tiny, fenêtre centrée (T26.0).",
      "type": "object",
      "required": ["layer", "k", "s"],
      "additionalProperties": false,
      "properties": {
        "layer": {"$ref": "#/$defs/id"},
        "k": {"enum": [2, 5]},
        "s": {"enum": [1, 2]}
      },
      "if": {"properties": {"k": {"const": 5}}},
      "then": {"properties": {"s": {"const": 1}}}
    },
    "conv": {
      "type": "object",
      "required": ["id", "type", "k", "s", "pad", "cin", "cout", "act", "fused_pool",
                   "w_offset", "b_offset", "m0_offset", "shift", "in_scale", "out_scale",
                   "in", "out", "out_shape"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "conv"},
        "k": {"enum": [1, 3]},
        "s": {
          "description": "Stride. 2 (YOLOv4-tiny, T24.3) : calculée en stride 1 puis décimée dans l'étage de sortie (une ligne et une colonne sur deux), jamais avec un maxpool fusionné.",
          "enum": [1, 2]
        },
        "pad": {"type": "integer", "minimum": 0},
        "cin": {"$ref": "#/$defs/dim"},
        "cout": {"$ref": "#/$defs/dim"},
        "act": {"enum": ["leaky", "linear"]},
        "fused_pool": {
          "description": "Maxpool fusionné ; out_shape est alors la carte poolée de cette conv (ses cout canaux), y compris quand le maxpool suit une route de plusieurs convs.",
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/pool"}]
        },
        "prepool_out": {
          "description": "Seconde sortie : la carte avant pooling, écrite pour une route.",
          "$ref": "#/$defs/bufref"
        },
        "w_offset": {"$ref": "#/$defs/offset64"},
        "b_offset": {"$ref": "#/$defs/offset64"},
        "m0_offset": {"$ref": "#/$defs/offset64"},
        "cs_offset": {"description": "ABFT (T25.2): offset of the checksum filter Σ_f qW_f (int32, cin × k × k) in checksum.bin.", "$ref": "#/$defs/offset64"},
        "cs_b": {"description": "ABFT (T25.2): Σ_f q_b,f wrapped to int32 (the check is modulo 2^32).", "type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "shift": {"type": "integer", "minimum": 1, "maximum": 62},
        "qmax": {
          "description": "Saturation de la sortie dans [−qmax, qmax] (défaut 127 ; 2^{b−1} − 1 pour des activations à b bits, T9.3).",
          "type": "integer", "minimum": 1, "maximum": 127
        },
        "wbits": {
          "description": "Bits de stockage des poids dans weights.bin (défaut 8). 4 : deux poids par octet, quartet bas = poids d'indice pair dans l'ordre (cout, cin, k, k), valeurs dans [−8, 7] (T10.10).",
          "enum": [4, 8]
        },
        "in_scale": {"$ref": "#/$defs/scale"},
        "out_scale": {"$ref": "#/$defs/scale"},
        "in": {"$ref": "#/$defs/bufref"},
        "out": {"$ref": "#/$defs/bufref"},
        "out_shape": {"$ref": "#/$defs/shape"}
      }
    },
    "maxpool": {
      "type": "object",
      "required": ["id", "type", "k", "s", "fused_into", "out_shape"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "maxpool"},
        "k": {"enum": [2, 5]},
        "s": {"enum": [1, 2]},
        "fused_into": {
          "description": "La conv qui précède, ou la route qui précède : le maxpool est alors fusionné dans chacune de ses sources (T24.3).",
          "$ref": "#/$defs/id"
        },
        "out_shape": {"$ref": "#/$defs/shape"}
      }
    },
    "upsample": {
      "type": "object",
      "required": ["id", "type", "s", "scale", "in", "out", "out_shape"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "upsample"},
        "s": {"const": 2},
        "scale": {"$ref": "#/$defs/scale"},
        "in": {"$ref": "#/$defs/bufref"},
        "out": {"$ref": "#/$defs/bufref"},
        "out_shape": {"$ref": "#/$defs/shape"}
      }
    },
    "route": {
      "description": "Concaténation sur les canaux. contiguous : les sources sont déjà écrites bout à bout dans le même tampon, la route ne copie rien (si un maxpool la suit, elles y sont écrites poolées et out désigne la concaténation poolée). grouped (CSP de YOLOv4-tiny) : une seule source, dont la route garde le groupe group_id sur groups ; out = sa source décalée de group_id·(C/groups)·H·W.",
      "type": "object",
      "required": ["id", "type", "from", "layout", "scale", "out", "out_shape"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "route"},
        "from": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "layout": {"enum": ["contiguous", "grouped"]},
        "groups": {"type": "integer", "minimum": 2},
        "group_id": {"type": "integer", "minimum": 0},
        "scale": {"$ref": "#/$defs/scale"},
        "out": {"$ref": "#/$defs/bufref"},
        "out_shape": {"$ref": "#/$defs/shape"}
      }
    },
    "yolo": {
      "type": "object",
      "required": ["id", "type", "mask", "scale", "in", "out_shape"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "yolo"},
        "mask": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "scale_x_y": {
          "description": "Darknet scale_x_y = α (YOLOv4-tiny) : centre σ(t)·α − (α − 1)/2 ; absent : 1.",
          "type": "number", "exclusiveMinimum": 0
        },
        "new_coords": {
          "description": "Darknet new_coords (YOLOv7-tiny, T26.0) : la tête est linéaire, la sigmoïde est dans le décodage, b_w = p_w·(2σ(t_w))² ; absent : 0.",
          "const": 1
        },
        "scale": {"$ref": "#/$defs/scale"},
        "in": {"$ref": "#/$defs/bufref"},
        "out_shape": {"$ref": "#/$defs/shape"},
        "lut_offset": {"$ref": "#/$defs/lut_offset"},
        "exp_frac": {"$ref": "#/$defs/exp_frac"}
      }
    },
    "region": {
      "description": "Sortie YOLOv2 : toutes les ancres (num), classes par softmax (§8.1).",
      "type": "object",
      "required": ["id", "type", "num", "scale", "in", "out_shape"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "region"},
        "num": {"type": "integer", "minimum": 1},
        "scale": {"$ref": "#/$defs/scale"},
        "in": {"$ref": "#/$defs/bufref"},
        "out_shape": {"$ref": "#/$defs/shape"},
        "lut_offset": {"$ref": "#/$defs/lut_offset"},
        "exp_frac": {"$ref": "#/$defs/exp_frac"}
      }
    }
  }
}
